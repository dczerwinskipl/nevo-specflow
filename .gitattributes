# Normalize line endings: repo is LF, checkout is LF everywhere.
* text=auto eol=lf

# Explicit text
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.json   text eol=lf
*.jsonc  text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.sh     text eol=lf

# Windows-only scripts keep CRLF
*.ps1    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.pdf    binary

# Generated files: collapsed by default in PR diffs and excluded from language
# stats — but still diffable. The lockfile in particular must stay reviewable for
# supply-chain / reproducibility checks, so it does NOT get `-diff`.
pnpm-lock.yaml            linguist-generated=true
docs/**/*.generated.*     linguist-generated=true -diff
**/*.generated.*          linguist-generated=true
docs/**                   linguist-documentation=true
# The Runtime OpenAPI document is generated (`pnpm api:openapi`) but its diff is the API review
# surface of a pull request, so it stays diffable (overrides `-diff` above).
docs/reference/api/openapi.generated.json  linguist-generated=true diff text eol=lf
