{
  "name": "@nevo/figma-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Product-neutral typed authoring, canonical IR, and validation contracts for code-to-Figma projection.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "default": "./dist/authoring/index.js"
    },
    "./ir": {
      "types": "./dist/ir/ir.d.ts",
      "default": "./dist/ir/ir.js"
    },
    "./schema": {
      "types": "./dist/ir/schema.d.ts",
      "default": "./dist/ir/schema.js"
    }
  },
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
