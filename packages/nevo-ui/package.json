{
  "name": "@nevo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable Nevo UI components, foundations, and product-neutral application layout mechanics.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./figma": {
      "types": "./dist/figma/index.d.ts",
      "import": "./dist/figma/index.js"
    },
    "./figma/define": {
      "types": "./dist/figma/define.d.ts",
      "import": "./dist/figma/define.js"
    },
    "./figma/resources": {
      "types": "./dist/figma/resources.d.ts",
      "import": "./dist/figma/resources.js"
    },
    "./design-system/color": {
      "types": "./dist/design-system/color.d.ts",
      "import": "./dist/design-system/color.js"
    },
    "./design-system/resources": {
      "types": "./dist/design-system/resources.d.ts",
      "import": "./dist/design-system/resources.js"
    },
    "./design-system/theme": {
      "types": "./dist/design-system/theme.d.ts",
      "import": "./dist/design-system/theme.js"
    }
  },
  "scripts": {
    "build": "pnpm generate:brand-environment && vite build && tsc -p tsconfig.build.json && node scripts/verify-package.mjs",
    "generate:brand-environment": "tsx scripts/generate-brand-environment.mts",
    "check:token-classes": "tsx scripts/token-classes.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@nevo/figma-capture": "workspace:*",
    "@nevo/figma-core": "workspace:*",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-table": "9.3.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react-aria-components": "1.22.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
