{
  "name": "@nevo/specflow-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared SpecFlow product contracts consumed by Runtime and UI.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./authorization": {
      "types": "./dist/authorization/index.d.ts",
      "default": "./dist/authorization/index.js"
    },
    "./authentication": {
      "types": "./dist/authentication.d.ts",
      "default": "./dist/authentication.js"
    },
    "./specs": {
      "types": "./dist/specs/index.d.ts",
      "default": "./dist/specs/index.js"
    },
    "./specs/overview": {
      "types": "./dist/specs/overview/index.d.ts",
      "default": "./dist/specs/overview/index.js"
    },
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "default": "./dist/sessions/index.js"
    },
    "./authorization/capability-discovery": {
      "types": "./dist/authorization/capability-discovery.d.ts",
      "default": "./dist/authorization/capability-discovery.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nevo/authorization": "workspace:*",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
