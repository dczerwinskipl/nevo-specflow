{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nevo:specflow:archetype-definitions:1",
  "title": "Nevo SpecFlow archetype definitions",
  "description": "Declarative definitions of document types, archetypes, requirements and templates (schemaVersion 1).",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "documentTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "useWhen",
          "instructions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Limit: 1000 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
          },
          "useWhen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Limit: 1000 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "description": "Limit: 16384 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
          },
          "defaultFilename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "additionalProperties": false
      }
    },
    "archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "title",
          "description",
          "useWhen",
          "requirements",
          "templates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Limit: 1000 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
          },
          "useWhen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Limit: 1000 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "description": "Limit: 16384 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "documentType",
                "minCount"
              ],
              "properties": {
                "documentType": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,31}$"
                },
                "minCount": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "contains": {
              "type": "object",
              "required": [
                "documentType",
                "minCount"
              ],
              "properties": {
                "documentType": {
                  "type": "string",
                  "const": "overview"
                },
                "minCount": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "templates": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "id",
                    "documentType",
                    "filename",
                    "content",
                    "include"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                    },
                    "documentType": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,31}$"
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384,
                      "description": "Limit: 16384 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
                    },
                    "content": {
                      "type": "string",
                      "maxLength": 65536,
                      "description": "Limit: 65536 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
                    },
                    "include": {
                      "type": "string",
                      "const": "always"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "id",
                    "documentType",
                    "filename",
                    "content",
                    "include"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                    },
                    "documentType": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,31}$"
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "instructions": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384,
                      "description": "Limit: 16384 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
                    },
                    "content": {
                      "type": "string",
                      "maxLength": 65536,
                      "description": "Limit: 65536 UTF-8 bytes. This schema bounds characters only; the exact byte check is applied by the Engine."
                    },
                    "include": {
                      "type": "string",
                      "const": "optional"
                    },
                    "preselected": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "contains": {
              "type": "object",
              "required": [
                "documentType",
                "include"
              ],
              "properties": {
                "documentType": {
                  "type": "string",
                  "const": "overview"
                },
                "include": {
                  "type": "string",
                  "const": "always"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
