{
  "name": "@nevo/specflow-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-capable SpecFlow application boundary; no CLI, HTTP, provider or UI dependencies.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --testTimeout=20000",
    "test:filesystem:smoke": "vitest run --testTimeout=20000 --maxWorkers=1 --no-file-parallelism test/project-home.test.ts test/version-control-adapter.test.ts test/version-control-legacy-regression.test.ts test/platform-filesystem-contract.test.ts",
    "test:filesystem:full": "vitest run --testTimeout=20000 --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  }
}
