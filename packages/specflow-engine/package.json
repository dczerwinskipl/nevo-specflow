{
  "name": "@nevo/specflow-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-capable SpecFlow application boundary; no CLI, HTTP, provider or UI dependencies. Shares only the neutral documents vocabulary of @nevo/specflow-contracts.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && node ../../tools/eslint/check-import-cycles.mjs",
    "test": "vitest run --testTimeout=20000",
    "test:unit": "vitest run --testTimeout=20000 test/version-control-policy.test.ts test/git-output-decoder.test.ts test/shared-resource-coordination.test.ts",
    "test:filesystem:smoke": "vitest run --testTimeout=20000 --maxWorkers=1 --no-file-parallelism test/project-home.test.ts test/version-control-adapter.test.ts test/version-control-legacy-regression.test.ts test/platform-filesystem-contract.test.ts",
    "test:filesystem:full": "vitest run --testTimeout=20000 --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@nevo/specflow-contracts": "workspace:*",
    "typebox": "1.4.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  }
}
