{
  "name": "@nevo/specflow-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nevo SpecFlow Runtime vertical: configurable long-lived Runtime server and authentication foundation, bundled into @nevo/specflow.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/command.d.ts",
      "default": "./dist/cli/command.js"
    }
  },
  "files": [
