{
  "name": "@nevo/specflow-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nevo SpecFlow Runtime vertical: configurable long-lived Runtime server, authentication, and authorization foundation, bundled into @nevo/specflow.",
  "license": "MIT",
  "exports": {
    "./antigravity-hook": {
      "types": "./dist/antigravity-hook.d.ts",
      "default": "./dist/antigravity-hook.js"
    },
    "./session-worker": {
      "types": "./dist/session-worker.d.ts",
      "default": "./dist/session-worker.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi-document": {
      "types": "./dist/openapi-document.d.ts",
      "default": "./dist/openapi-document.js"
    },
    "./cli": {
      "types": "./dist/cli/command.d.ts",
      "default": "./dist/cli/command.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=20000"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/type-provider-typebox": "6.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nevo/authorization": "workspace:*",
    "@nevo/specflow-contracts": "workspace:*",
    "@nevo/specflow-docs": "workspace:*",
    "@nevo/specflow-engine": "workspace:*",
    "commander": "15.0.0",
    "fastify": "5.12.8",
    "koffi": "3.3.7",
    "openid-client": "6.8.9",
    "typebox": "1.4.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@nevo/ai-semantic-search": "workspace:*",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.20.0 <25"
  }
}
