{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuild/specflow-ui.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "@nevo/figma-capture/metadata": ["../figma-capture/src/metadata.tsx"],
      "@nevo/figma-core": ["../figma-core/src/index.ts"],
      "@nevo/figma-core/*": ["../figma-core/src/*"],
      "@nevo/http-client": ["../http-client/src/index.ts"],
      "@nevo/specflow-contracts": ["../specflow-contracts/src/index.ts"],
      "@nevo/specflow-contracts/specs/overview": [
        "../specflow-contracts/src/specs/overview/index.ts"
      ],
      "@nevo/specflow-contracts/*": ["../specflow-contracts/src/*"],
      "@nevo/ui": ["../nevo-ui/src/index.ts"],
      "@nevo/ui/*": ["../nevo-ui/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
