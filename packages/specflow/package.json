{
  "name": "@nevo/specflow",
  "version": "0.0.0",
  "type": "module",
  "description": "Nevo SpecFlow — spec-driven development for AI-assisted software engineering. Ships the public `nevo-specflow` CLI.",
  "license": "MIT",
  "bin": {
    "nevo-specflow": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "node packaging/bin.ts bundle",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --no-file-parallelism",
    "artifact:pack": "node packaging/bin.ts pack",
    "dogfood": "node packaging/bin.ts dogfood",
    "test:packaged": "vitest run test/packaging.smoke.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@nevo/specflow-runtime": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "commander": "15.0.0",
    "cross-spawn": "7.0.6",
    "esbuild": "0.28.2",
    "vitest": "5.0.3"
  }
}
