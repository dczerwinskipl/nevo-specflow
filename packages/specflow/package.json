{
  "name": "@nevo/specflow",
  "version": "0.0.0",
  "type": "module",
  "description": "Nevo SpecFlow — spec-driven development for AI-assisted software engineering. Ships the public `nevo-spec` CLI.",
  "license": "MIT",
  "bin": {
    "nevo-spec": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "node ../../tools/product/dist/bin.js bundle",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@nevo/specflow-dashboard": "workspace:*"
  },
  "devDependencies": {
    "commander": "15.0.0",
    "vitest": "5.0.0"
  }
}
