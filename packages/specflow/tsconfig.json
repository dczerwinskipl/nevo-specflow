{
  "extends": "../../tsconfig.package-node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./.tsbuild/specflow.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@nevo/authorization": ["../authorization/src/index.ts"],
      "@nevo/specflow-contracts": ["../specflow-contracts/src/index.ts"],
      "@nevo/specflow-contracts/authorization": ["../specflow-contracts/src/authorization.ts"],
      "@nevo/specflow-engine": ["../specflow-engine/src/index.ts"],
      "@nevo/specflow-engine/testing": ["../specflow-engine/src/testing.ts"],
      "@nevo/specflow-runtime": ["../specflow-runtime/src/index.ts"],
      "@nevo/specflow-runtime/cli": ["../specflow-runtime/src/cli/command.ts"]
    }
  },
  "include": ["src/**/*.ts", "packaging/**/*.ts", "test/**/*.ts"]
}
