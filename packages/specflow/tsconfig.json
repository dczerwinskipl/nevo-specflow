{
  "extends": "../../tsconfig.package-node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./.tsbuild/specflow.tsbuildinfo",
    "paths": {
      "@nevo/authorization": [
        "../authorization/src/index.ts"
      ],
      "@nevo/specflow-contracts": [
        "../specflow-contracts/src/index.ts"
      ],
      "@nevo/specflow-contracts/authorization": [
        "../specflow-contracts/src/authorization.ts"
      ],
      "@nevo/specflow-runtime": [
        "../specflow-runtime/src/index.ts"
      ],
      "@nevo/specflow-runtime/cli": [
        "../specflow-runtime/src/cli/command.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "packaging/**/*.ts",
    "test/**/*.ts"
  ]
}
