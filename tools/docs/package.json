{
  "name": "nevo-repo-docs",
  "private": true,
  "type": "module",
  "description": "Repository launcher for the product documentation capability (@nevo/specflow-docs) plus ADR authoring and repository-only ADR checks. Not a product package.",
  "license": "MIT",
  "bin": {
    "nevo-docs": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nevo/specflow-docs": "workspace:*",
    "commander": "15.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
