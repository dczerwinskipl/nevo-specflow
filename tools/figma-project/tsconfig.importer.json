{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuild/figma-project-importer.tsbuildinfo",
    "types": ["@figma/plugin-typings", "node"],
    "paths": {
      "@nevo/figma-core": ["../../packages/figma-core/src/index.ts"],
      "@nevo/figma-core/*": ["../../packages/figma-core/src/*"],
      "@nevo/ui/*": ["../../packages/nevo-ui/src/*"],
      "@nevo/specflow-ui/*": ["../../apps/specflow-ui/src/*"],
      "nevo-example-crm/*": ["../../examples/crm/src/*"],
      "nevo-figma-import/*": ["../figma-import/*"]
    }
  },
  "include": ["src/importer.ts"]
}
