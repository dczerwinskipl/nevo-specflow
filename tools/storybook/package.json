{
  "name": "nevo-repo-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository Storybook host for Nevo UI, SpecFlow, and examples.",
  "license": "MIT",
  "scripts": {
    "build": "storybook build --output-dir dist",
    "build-storybook": "storybook build --output-dir dist",
    "chromatic": "chromatic --exit-zero-on-changes",
    "dev": "storybook dev -p 6006",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project=storybook"
  },
  "dependencies": {
    "@nevo/figma-core": "workspace:*",
    "@nevo/specflow-ui": "workspace:*",
    "@nevo/ui": "workspace:*",
    "nevo-example-crm": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.40",
    "@types/node": "24.19.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/browser-playwright": "4.1.11",
    "chromatic": "18.10.1",
    "playwright": "1.55.0",
    "storybook": "10.6.0",
    "vite": "7.1.4",
    "vitest": "4.1.11"
  }
}
