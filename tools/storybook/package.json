{
  "name": "nevo-repo-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository Storybook host for Nevo UI, SpecFlow, and examples.",
  "license": "MIT",
  "scripts": {
    "build": "storybook build --output-dir dist",
    "build-storybook": "storybook build --output-dir dist",
    "chromatic": "chromatic --exit-zero-on-changes --only-changed --externals \"packages/nevo-ui/src/**/*.css\" --externals \"packages/specflow-ui/src/**/*.css\" --externals \"examples/**/*.css\" --externals \"tools/storybook/.storybook/**/*\" --externals \"pnpm-lock.yaml\"",
    "dev": "storybook dev -p 6006",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project=storybook"
  },
  "dependencies": {
    "@nevo/figma-core": "workspace:*",
    "@nevo/specflow-ui": "workspace:*",
    "@nevo/ui": "workspace:*",
    "nevo-example-crm": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@nevo/figma-capture": "workspace:*",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-router": "1.170.46",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "chromatic": "18.14.1",
    "playwright": "1.65.0",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.4",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
