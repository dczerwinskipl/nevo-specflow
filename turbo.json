{
  "$schema": "https://turborepo.com/schema.json",
  "//": "Only genuinely cross-package build inputs are global. Prettier/EditorConfig affect `pnpm format`, which is not a Turbo task, so they are deliberately NOT listed here. ESLint is a per-package `lint` task whose inputs name the shared lint config explicitly. The lockfile and root package.json are hashed by Turbo automatically.",
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.package-neutral.json",
    "tsconfig.package-node.json",
    "tools/build-package.mjs"
  ],
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.stories.*", "!**/*.test.*"],
      "outputs": ["dist/**", "build/**", ".output/**"]
    },
    "build:plugin": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.stories.*", "!**/*.test.*"],
      "outputs": ["dist/plugin/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["*.tsbuildinfo", ".tsbuild/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/eslint.base.mjs",
        "$TURBO_ROOT$/tools/eslint/*.mjs"
      ],
      "outputs": []
    },
    "//#lint:root": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
